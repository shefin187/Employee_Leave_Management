@model IEnumerable<Employee_Leave_Management.Models.LeaveRequest>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="bg-[#F8FAFC] min-h-screen p-8 text-slate-800">

    <!-- Top Header Bar -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Employee Leave Management System</p>
            <h1 class="text-2xl font-bold text-slate-900 mt-1">Dashboard</h1>
        </div>
        <div class="flex items-center gap-4">
            <button onclick="toggleModal(true)" class="bg-[#00897B] hover:bg-[#00796B] text-white px-5 py-2.5 rounded-lg font-medium shadow-sm transition flex items-center gap-2 text-sm">
                <i class="fa-solid fa-plus"></i> Apply for Leave
            </button>
            <div class="flex items-center gap-3 pl-4 border-l border-slate-200">
                <div class="text-right">
                    <p class="text-xs text-slate-400">Welcome,</p>
                    <p class="text-sm font-semibold text-slate-700">Shefin <span class="text-slate-400 font-normal">(Admin)</span></p>
                </div>
                <div class="relative">
                    <i class="fa-regular fa-bell text-slate-500 text-lg"></i>
                    <span class="absolute -top-1 -right-1 w-2 h-2 bg-rose-500 rounded-full"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Pending Approvals</p>
            <p class="text-3xl font-bold text-slate-900 mt-2">@(Model?.Count(r => r.LeaveStatus == "Pending") ?? 0)</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Approved</p>
            <p class="text-3xl font-bold text-slate-900 mt-2">@(Model?.Count(r => r.LeaveStatus == "Approved") ?? 0)</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Total Requests</p>
            <p class="text-3xl font-bold text-slate-900 mt-2">@(Model?.Count() ?? 0) <span class="text-base font-semibold text-slate-400">Total</span></p>
        </div>
    </div>

    <!-- Recent Leave Requests Table -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100">
            <h2 class="text-lg font-bold text-slate-800">Recent Leave Requests</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-6">Employee Name</th>
                        <th class="py-4 px-4">From Date</th>
                        <th class="py-4 px-4">To Date</th>
                        <th class="py-4 px-6">Reason</th>
                        <th class="py-4 px-6 text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="py-4 px-6 font-medium text-slate-900">@item.EmployeeName</td>
                                <td class="py-4 px-4">@item.FromDate.ToShortDateString()</td>
                                <td class="py-4 px-4">@item.ToDate.ToShortDateString()</td>
                                <td class="py-4 px-6 text-slate-500 max-w-xs truncate">@item.Reason</td>
                                <td class="py-4 px-6 text-center">
                                    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold
                                        @(item.LeaveStatus == "Approved" ? "bg-emerald-100 text-emerald-700" :
                                          item.LeaveStatus == "Rejected" ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-700")">
                                        @item.LeaveStatus.ToUpper()
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-400">
                                No leave requests found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CENTERED APPLY FOR LEAVE MODAL -->
<div id="leaveModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center z-50 p-4">
    <div class="bg-white w-full max-w-xl rounded-2xl shadow-2xl border border-slate-100 overflow-hidden">

        <!-- Modal Header -->
        <div class="px-6 py-4 bg-slate-900 text-white flex justify-between items-center">
            <h3 class="text-base font-bold tracking-wide uppercase flex items-center gap-2">
                <i class="fa-solid fa-calendar-plus text-teal-400"></i> Apply for Leave
            </h3>
            <button type="button" onclick="toggleModal(false)" class="text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <!-- Form Body -->
        <form asp-controller="Leave" asp-action="Create" method="post" class="p-6 space-y-5">
            @Html.AntiForgeryToken()

            <!-- Select Employee -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    Select Employee:
                </label>
                <div class="relative">
                    <select name="EmployeeName"
                            asp-items="ViewBag.EmployeeList"
                            required
                            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-800 appearance-none focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                        <option value="" disabled selected>Select Employee Name</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-400">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </div>
                </div>
            </div>

            <!-- Dates Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                        From Date:
                    </label>
                    <input type="date" name="FromDate" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                        To Date:
                    </label>
                    <input type="date" name="ToDate" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                </div>
            </div>

            <!-- Reason -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                    Reason for Leave:
                </label>
                <textarea name="Reason" rows="3" placeholder="Write your reason here..." required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:bg-white transition resize-none"></textarea>
            </div>

            <!-- Footer Buttons -->
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="toggleModal(false)" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-sm font-semibold transition">
                    Cancel
                </button>
                <button type="submit" class="px-6 py-2.5 bg-[#00897B] hover:bg-[#00796B] text-white rounded-lg text-sm font-semibold transition shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane text-xs"></i> Submit Application
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleModal(show) {
        const modal = document.getElementById('leaveModal');
        if (show) {
            modal.classList.remove('hidden');
        } else {
            modal.classList.add('hidden');
        }
    }
</script>