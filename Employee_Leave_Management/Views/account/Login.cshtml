@model Employee_Leave_Management.Models.Employee

@{
    Layout = null; // Fullscreen layout without sidebar for login
    ViewData["Title"] = "Portal Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Leave Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4">

    <!-- MAIN CONTAINER -->
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl relative overflow-hidden">

        <!-- STEP 1: ROLE SELECTION SCREEN -->
        <div id="roleSelectionStep" class="flex flex-col items-center text-center space-y-6">
            <div>
                <h1 class="text-2xl font-bold text-white mb-1">Welcome Back</h1>
                <p class="text-sm text-slate-400">Please select your login portal to continue</p>
            </div>

            <div class="w-full space-y-4 pt-2">
                <!-- Admin Button -->
                <button onclick="showLoginForm('Admin')"
                        class="w-full py-3 px-6 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-indigo-600/20 flex items-center justify-center gap-3">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Admin Login</span>
                </button>

                <!-- Employee Button -->
                <button onclick="showLoginForm('Employee')"
                        class="w-full py-3 px-6 bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-slate-700 font-semibold rounded-xl transition-all duration-200 flex items-center justify-center gap-3">
                    <i class="fa-solid fa-user"></i>
                    <span>Employee Login</span>
                </button>
            </div>
        </div>

        <!-- STEP 2: DYNAMIC LOGIN FORM -->
        <div id="loginFormStep" class="hidden">
            <!-- Header with Back Button -->
            <div class="flex items-center justify-between mb-6">
                <button type="button" onclick="showRoleSelection()" class="text-slate-400 hover:text-white transition-colors flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </button>
                <span id="roleBadge" class="text-xs px-3 py-1 rounded-full font-medium"></span>
            </div>

            <h2 id="loginTitle" class="text-2xl font-bold text-white mb-6">Login</h2>

            <!-- Error Message Alerts -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="mb-4 p-3 bg-red-500/10 border border-red-500/20 text-red-400 text-sm rounded-xl">
                    @ViewBag.ErrorMessage
                </div>
            }

            <div asp-validation-summary="All" class="mb-4 text-red-400 text-sm font-medium space-y-1"></div>

            <!-- Login Form Submission -->
            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <!-- Hidden field to pass selected role to ASP.NET Controller -->
                <input type="hidden" id="selectedRole" name="Role" value="" />

                <!-- Email Input -->
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1.5">Email Address</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-envelope"></i>
                        </span>
                        <input type="email" name="Email" required placeholder="name@company.com"
                               class="w-full bg-slate-800 border border-slate-700 rounded-xl py-2.5 pl-10 pr-4 text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                    </div>
                </div>

                <!-- Password Input -->
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1.5">Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input type="password" name="Password" required placeholder="••••••••"
                               class="w-full bg-slate-800 border border-slate-700 rounded-xl py-2.5 pl-10 pr-4 text-white focus:outline-none focus:border-indigo-500 transition-colors" />
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="submitBtn"
                        class="w-full py-3 px-6 text-white font-semibold rounded-xl transition-all duration-200 mt-2">
                    Login
                </button>
            </form>
        </div>

    </div>

    <!-- UI INTERACTION SCRIPT -->
    <script>
            function showLoginForm(role) {
                document.getElementById('roleSelectionStep').classList.add('hidden');
                document.getElementById('loginFormStep').classList.remove('hidden');

                document.getElementById('selectedRole').value = role;
                document.getElementById('loginTitle').innerText = role + ' Login';

                const badge = document.getElementById('roleBadge');
                const submitBtn = document.getElementById('submitBtn');

                if (role === 'Admin') {
                    badge.innerText = 'Admin Portal';
                    badge.className = 'text-xs px-3 py-1 rounded-full font-medium bg-indigo-500/10 text-indigo-400 border border-indigo-500/20';
                    submitBtn.className = 'w-full py-3 px-6 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition-all duration-200 mt-2 shadow-lg shadow-indigo-600/20';
                } else {
                    badge.innerText = 'Employee Portal';
                    badge.className = 'text-xs px-3 py-1 rounded-full font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
                    submitBtn.className = 'w-full py-3 px-6 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl transition-all duration-200 mt-2 shadow-lg shadow-emerald-600/20';
                }
            }

            function showRoleSelection() {
                document.getElementById('loginFormStep').classList.add('hidden');
                document.getElementById('roleSelectionStep').classList.remove('hidden');
            }

            // Auto-reopen login form if the page reloaded due to validation errors
            document.addEventListener("DOMContentLoaded", function() {
                const hasErrors = document.querySelector('[asp-validation-summary="All"]')?.children.length > 0;
                const selectedRole = document.getElementById('selectedRole').value;

                if (hasErrors && selectedRole) {
                    showLoginForm(selectedRole);
                }
            });
    </script>
</body>
</html>