@model Employee_Leave_Management.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<h2>Add Employee</h2>

<form asp-controller="Employeeapi"
      asp-action="Index1"
      method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <br />

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <br />

    <div>
        <label>Department</label>
        <input asp-for="Department" />
    </div>

    <br />

    <button type="submit">Add Employee</button>
</form>

<br />

<a asp-controller="Employeeapi"
   asp-action="Index">
    Back to Employee List
</a>