@model List<Employee_Leave_Management.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h1>Employee List</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Email</td>
            </tr>
        }
    </tbody>
</table>