@model IEnumerable<Employee_Leave_Management.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Analytics & Reports";
}

<div class="p-6 space-y-8">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Leave Analytics & Reports</h1>
        <p class="text-sm text-slate-500">Summary overview of leave utilization and request statuses.</p>
    </div>

    <!-- Summary KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Total Requests -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Applications</p>
                <h3 class="text-3xl font-extrabold text-slate-800 mt-1">@ViewBag.TotalRequests</h3>
            </div>
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl font-bold">
                <i class="fa-solid fa-folder-open"></i>
            </div>
        </div>

        <!-- Approved -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Approved Leaves</p>
                <h3 class="text-3xl font-extrabold text-emerald-600 mt-1">@ViewBag.ApprovedCount</h3>
            </div>
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl font-bold">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>

        <!-- Pending -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Pending Requests</p>
                <h3 class="text-3xl font-extrabold text-amber-500 mt-1">@ViewBag.PendingCount</h3>
            </div>
            <div class="w-12 h-12 bg-amber-50 text-amber-500 rounded-xl flex items-center justify-center text-xl font-bold">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>

        <!-- Rejected -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Rejected Requests</p>
                <h3 class="text-3xl font-extrabold text-rose-600 mt-1">@ViewBag.RejectedCount</h3>
            </div>
            <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-xl font-bold">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
        </div>
    </div>

    <!-- Detailed Breakout Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
            <h2 class="text-base font-bold text-slate-800">Leave Summary Logs</h2>
            <button onclick="window.print()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition flex items-center gap-2">
                <i class="fa-solid fa-print"></i> Print Report
            </button>
        </div>

        <table class="w-full text-left border-collapse text-sm">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 uppercase text-xs font-semibold">
                <tr>
                    <th class="py-3 px-6">Employee Name</th>
                    <th class="py-3 px-6">Duration</th>
                    <th class="py-3 px-6">Reason</th>
                    <th class="py-3 px-6 text-center">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition">
                            <td class="py-3.5 px-6 font-medium text-slate-900">@item.EmployeeName</td>
                            <td class="py-3.5 px-6">
                                @item.FromDate.ToString("MMM dd, yyyy") &rarr; @item.ToDate.ToString("MMM dd, yyyy")
                            </td>
                            <td class="py-3.5 px-6 max-w-sm truncate text-slate-500">@item.Reason</td>
                            <td class="py-3.5 px-6 text-center">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold
                                    @(item.LeaveStatus == "Approved" ? "bg-emerald-100 text-emerald-800" :
                                      item.LeaveStatus == "Rejected" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                    @item.LeaveStatus
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-8 text-center text-slate-400">
                            No report data available.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>