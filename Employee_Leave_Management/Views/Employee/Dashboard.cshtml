@model IEnumerable<Employee_Leave_Management.Models.LeaveRequest>

@{
    ViewData["Title"] = "Employee Portal";
}

<div class="min-h-screen bg-slate-900 text-slate-100 p-6 space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-white">Employee Dashboard</h1>
            <p class="text-slate-400 text-sm mt-1">Submit new leave applications and track your request status.</p>
        </div>
        
        <!-- Primary Action Button -->
        <button onclick="openLeaveModal()" 
                class="px-5 py-3 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl shadow-lg shadow-teal-900/30 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
            <i class="fa-solid fa-plus text-sm"></i>
            <span>Add Leave Request</span>
        </button>
    </div>

<!-- ADD LEAVE REQUEST MODAL -->
<div id="leaveModal" class="hidden fixed inset-0 bg-slate-950/70 backdrop-blur-sm flex items-center justify-center z-50 p-4 transition-opacity">
    <div class="bg-slate-900 border border-slate-700/80 w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden">
        
        <!-- Modal Header -->
        <div class="px-6 py-4 bg-slate-800/80 border-b border-slate-700/80 flex justify-between items-center">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-paper-plane text-teal-400"></i> Submit Leave Request
            </h3>
            <button type="button" onclick="closeLeaveModal()" class="text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <!-- Form -->
        <form asp-controller="Leave" asp-action="Create" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <!-- Employee Name Field -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                    Your Name:
                </label>
                <input type="text" 
                       name="EmployeeName" 
                       placeholder="Enter your full name" 
                       required 
                       class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition" />
            </div>

            <!-- Dates Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                        From Date:
                    </label>
                    <input type="date" 
                           name="FromDate" 
                           required 
                           class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                        To Date:
                    </label>
                    <input type="date" 
                           name="ToDate" 
                           required 
                           class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition" />
                </div>
            </div>

            <!-- Reason Field -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                    Reason for Leave:
                </label>
                <textarea name="Reason" 
                          rows="3" 
                          placeholder="Please specify why you need leave..." 
                          required 
                          class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition resize-none"></textarea>
            </div>

            <!-- Buttons -->
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
                <button type="button" 
                        onclick="closeLeaveModal()" 
                        class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-semibold transition">
                    Cancel
                </button>
                <button type="submit" 
                        class="px-6 py-2.5 bg-teal-600 hover:bg-teal-500 text-white rounded-xl text-sm font-semibold transition shadow-md flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane text-xs"></i> Submit Request
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Script -->
<script>
    function openLeaveModal() {
        document.getElementById('leaveModal').classList.remove('hidden');
    }

    function closeLeaveModal() {
        document.getElementById('leaveModal').classList.add('hidden');
    }
</script>