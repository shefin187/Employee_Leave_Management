@model IEnumerable<Employee_Leave_Management.Models.Employee>

@{
    ViewData["Title"] = "Manage Employees";
}

<div class="p-8">
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Module 1</p>
            <h1 class="text-2xl font-bold text-slate-900 mt-1">Manage Employees</h1>
        </div>
        <button onclick="openEmployeeModal('create')" class="bg-[#00897B] hover:bg-[#00796B] text-white px-5 py-2.5 rounded-lg font-medium shadow-sm transition flex items-center gap-2 text-sm">
            <i class="fa-solid fa-user-plus"></i> Add New Employee
        </button>
    </div>

    <!-- Employee Table -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center">
            <h2 class="text-lg font-bold text-slate-800">All Employees</h2>
            <input type="text" placeholder="Search employee..." class="px-4 py-2 border border-slate-200 rounded-lg text-sm w-64 focus:outline-none focus:border-indigo-500">
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-6">ID</th>
                        <th class="py-4 px-6">Name</th>
                        <th class="py-4 px-6">Email</th>
                        <th class="py-4 px-6">Department</th>
                        <th class="py-4 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var emp in Model)
                        {
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="py-4 px-6 font-semibold text-slate-400">#@emp.Id</td>
                                <td class="py-4 px-6 font-medium text-slate-900">@emp.Name</td>
                                <td class="py-4 px-6">@emp.Email</td>
                                <td class="py-4 px-6">
                                    <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-indigo-50 text-indigo-700">@emp.Department</span>
                                </td>
                                <td class="py-4 px-6 text-right space-x-2">
                                    <button onclick="openEmployeeModal('edit', '@emp.Id', '@emp.Name', '@emp.Email', '@emp.Department')" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@emp.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this employee?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-red-400 hover:text-red-300 font-medium">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>


                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-400">
                                No employees found. Click <strong>"Add New Employee"</strong> to create one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CREATE / EDIT EMPLOYEE MODAL -->
<div id="employeeModal" class="hidden fixed inset-0 bg-slate-900/30 backdrop-blur-xs justify-end z-50">
    <div class="bg-white w-full max-w-md h-full shadow-2xl p-6 flex flex-col justify-between overflow-y-auto">
        <div>
            <!-- Modal Header -->
            <div class="flex justify-between items-center pb-4 mb-6 border-b border-slate-100">
                <h3 id="modalTitle" class="text-xs font-bold tracking-wider text-slate-800 uppercase">ADD NEW EMPLOYEE</h3>
                <button onclick="closeEmployeeModal()" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Dynamic Form -->
            <form id="employeeForm" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <input type="hidden" id="empId" name="Id" value="0" />

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Name</label>
                    <input type="text" id="empName" name="Name" placeholder="e.g. Jane Doe" required class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Email Address</label>
                    <input type="email" id="empEmail" name="Email" placeholder="e.g. jane@company.com" required class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Department</label>
                    <input type="text" id="empDept" name="Department" placeholder="e.g. IT, HR, Marketing" required class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Password</label>
                    <input type="text" id="empPass" name="Password" placeholder="" required class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500">
                </div>
            </form>
        </div>

        <!-- Footer Buttons -->
        <div class="flex gap-3 pt-6 border-t border-slate-100">
            <button type="button" onclick="closeEmployeeModal()" class="flex-1 py-2.5 px-4 bg-slate-500 hover:bg-slate-600 text-white rounded-lg text-sm font-medium transition">
                Cancel
            </button>
            <button type="submit" form="employeeForm" class="flex-1 py-2.5 px-4 bg-[#2D3154] hover:bg-[#232642] text-white rounded-lg text-sm font-medium transition">
                Save Employee
            </button>
        </div>
    </div>
</div>

<script>
    function openEmployeeModal(mode, id = 0, name = '', email = '', dept = '', pass = '') {
        const modal = document.getElementById('employeeModal');
        const title = document.getElementById('modalTitle');
        const form = document.getElementById('employeeForm');

        if (mode === 'edit') {
            title.innerText = 'EDIT EMPLOYEE DETAILS';
            form.action = '/Employee/Edit'; // Routes to public async Task<IActionResult> Edit(Employee model)
            document.getElementById('empId').value = id;
            document.getElementById('empName').value = name;
            document.getElementById('empEmail').value = email;
            document.getElementById('empDept').value = dept;
        } else {
            title.innerText = 'ADD NEW EMPLOYEE';
            form.action = '/Employee/Create'; // Routes to public IActionResult Create(Employee employee)
            form.reset();
            document.getElementById('empId').value = 0;
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeEmployeeModal() {
        const modal = document.getElementById('employeeModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>